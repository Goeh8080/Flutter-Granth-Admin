{
  "name": "granth-admin-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Granth admin panel + remote config.json + anonymous analytics on Cloudflare Workers + D1",
  "scripts": {
    "test": "node --test \"test/unit/*.test.mjs\"", "test:e2e": "node scripts/e2e.mjs", "test:ui": "node test/ui_smoke.mjs",
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "e2e": "node scripts/e2e.mjs",
    "build:deploy": "node scripts/build_deploy.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "wrangler": "^4"
  }
}
